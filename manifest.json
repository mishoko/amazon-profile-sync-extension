{
  "manifest_version": 3,
  "name": "Waybill",
  "version": "0.1.0",
  "description": "Track your marketplace purchases and order statuses.",
  "key": "",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.de/*",
    "https://www.amazon.es/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.ie/*",
    "https://www.amazon.it/*",
    "https://www.amazon.ae/*",
    "https://www.amazon.sa/*"
  ],
  "action": {
    "default_title": "Waybill",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
